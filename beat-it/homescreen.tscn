[sub_resource type="GDScript" id="GDScript_c2ysq"]
script/source = "extends Node2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if Runtime.last_score >= 0:
		var l := Label.new()
		l.text = \"Score: %d\" % Runtime.last_score
		l.position = Vector2(358, 250)
		l.add_theme_font_size_override(\"font_size\", 48)
		l.add_theme_color_override(\"font_color\", Color.WHITE)
		l.add_theme_color_override(\"font_outline_color\", Color.BLACK)
		l.add_theme_constant_override(\"outline_size\", 8)
		add_child(l)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_button_pressed() -> void:
	Runtime.selected_level = 1
	Runtime.last_score = -1
	get_tree().change_scene_to_file(\"res://level.tscn\")


func _on_button_2_pressed() -> void:
	Runtime.selected_level = 2
	Runtime.last_score = -1
	get_tree().change_scene_to_file(\"res://level.tscn\")


func _on_button_3_pressed() -> void:
	Runtime.selected_level = 3
	Runtime.last_score = -1
	get_tree().change_scene_to_file(\"res://level.tscn\")
"

